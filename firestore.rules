rules_version = '2';
service cloud.firestore {match /databases/{database}/documents {
function member(){return request.auth!=null && exists(/databases/$(database)/documents/members/$(request.auth.uid)) && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.enabled==true;}
match /members/{uid}{allow read:if member();allow write:if false;}
match /progress/{uid}{allow read,write:if member() && request.auth.uid==uid;}
match /results/{id}{allow read:if member();allow create:if member() && request.resource.data.uid==request.auth.uid && request.resource.data.code==get(/databases/$(database)/documents/members/$(request.auth.uid)).data.code;allow update,delete:if false;}
}}